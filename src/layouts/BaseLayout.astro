---
import '~/styles/global.css';
import SEO from '~/components/seo/SEO.astro';
import SiteSchema from '~/components/schema/SiteSchema.astro';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';
import WhatsAppFloat from '~/components/WhatsAppFloat.astro';
import GoogleAnalytics from '~/components/analytics/GoogleAnalytics.astro';
import { site } from '~/data/site';
import { lastmodForPath } from '~/data/content-dates';

// Verification codes for Google Search Console + Bing Webmaster Tools.
// Env vars take precedence so production deploys can override without commits.
const gscCode =
  (import.meta.env.PUBLIC_GSC_VERIFICATION as string | undefined)?.trim() ||
  site.analytics.searchConsoleVerification.trim();
const bingCode =
  (import.meta.env.PUBLIC_BING_VERIFICATION as string | undefined)?.trim() ||
  site.analytics.bingVerification.trim();

export interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
  type?: 'website' | 'article' | 'profile';
}

const { title, description, image, noindex, type } = Astro.props;

const lastModified = lastmodForPath(Astro.url.pathname);
const lastModifiedDisplay = new Date(lastModified).toLocaleDateString('en-GB', {
  year: 'numeric',
  month: 'long',
});
---

<!doctype html>
<html lang="en-AE" dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Preconnect for performance -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap"
      rel="stylesheet"
    />

    <SEO
      title={title}
      description={description}
      image={image}
      noindex={noindex}
      type={type}
    />
    <!-- Recency signals for search + AI answer engines (AEO/GEO) -->
    <meta name="article:modified_time" content={lastModified} />
    <meta property="og:updated_time" content={lastModified} />
    <meta name="last-modified" content={lastModified} />

    <!-- Search Console + Bing Webmaster verification (skipped if blank) -->
    {gscCode && <meta name="google-site-verification" content={gscCode} />}
    {bingCode && <meta name="msvalidate.01" content={bingCode} />}

    <!-- Analytics (loads only if a measurement ID is configured) -->
    <GoogleAnalytics />

    <SiteSchema />

    <slot name="head" />
  </head>
  <body class="min-h-screen bg-white text-ink-900 antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-ink-900 focus:px-4 focus:py-2 focus:text-white"
    >
      Skip to content
    </a>

    <Header />

    <main id="main">
      <slot />
    </main>

    <Footer lastUpdated={lastModifiedDisplay} />

    <WhatsAppFloat />
  </body>
</html>
