---
import type { FAQ } from '~/data/faqs';
export interface Props {
  faqs: FAQ[];
}
const { faqs } = Astro.props;
---

<ul class="divide-y divide-ink-200/70 rounded-2xl ring-1 ring-ink-200/70 bg-white">
  {faqs.map((f, i) => (
    <li>
      <details class="group" {...(i === 0 ? { open: true } : {})}>
        <summary class="flex cursor-pointer list-none items-start justify-between gap-4 px-5 py-5 sm:px-6 sm:py-6">
          <h3 class="text-base font-semibold text-ink-900 sm:text-lg">{f.question}</h3>
          <span class="mt-0.5 grid h-7 w-7 shrink-0 place-items-center rounded-full bg-ink-100 text-ink-700 transition-colors group-hover:bg-brand-100 group-hover:text-brand-700 group-open:rotate-45 group-open:bg-brand-500 group-open:text-white" aria-hidden="true">
            <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
              <path d="M12 5v14M5 12h14"/>
            </svg>
          </span>
        </summary>
        <div class="px-5 pb-6 text-sm text-ink-600 sm:px-6 sm:text-base">
          <p>{f.answer}</p>
        </div>
      </details>
    </li>
  ))}
</ul>
