---
export interface Props {
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  bg?: 'white' | 'ink-50' | 'ink-950';
  id?: string;
}
const { eyebrow, title, subtitle, bg = 'white', id } = Astro.props;

const bgClass = {
  'white': 'bg-white',
  'ink-50': 'bg-ink-50/60',
  'ink-950': 'bg-ink-950 text-white',
}[bg];
---

<section id={id} class={`${bgClass} py-16 sm:py-20`}>
  <div class="container-x">
    {(eyebrow || title || subtitle) && (
      <div class="max-w-2xl">
        {eyebrow && <span class="eyebrow">{eyebrow}</span>}
        {title && <h2 class={`${eyebrow ? 'mt-4' : ''} text-2xl font-extrabold tracking-tight sm:text-3xl ${bg === 'ink-950' ? 'text-white' : 'text-ink-900'}`}>{title}</h2>}
        {subtitle && <p class={`mt-3 ${bg === 'ink-950' ? 'text-ink-300' : 'text-ink-600'}`}>{subtitle}</p>}
      </div>
    )}
    <div class={`${(eyebrow || title || subtitle) ? 'mt-10' : ''}`}>
      <slot />
    </div>
  </div>
</section>
