---
import { whatsappUrl } from '~/data/site';
export interface Props {
  title?: string;
  subtitle?: string;
  primary?: string;
  secondary?: string;
}
const {
  title = 'Ready for a fresh coat?',
  subtitle = 'Get up to 5 free quotes from verified painters in under a minute.',
  primary = 'Get 5 free quotes',
  secondary = 'Chat on WhatsApp',
} = Astro.props;
---

<section class="relative overflow-hidden bg-gradient-to-br from-brand-600 via-brand-500 to-amber-500 py-14 sm:py-20">
  <div class="absolute inset-0 bg-grid opacity-20" aria-hidden="true"></div>
  <div class="absolute -top-24 -right-24 h-72 w-72 rounded-full bg-white/20 blur-3xl" aria-hidden="true"></div>
  <div class="absolute -bottom-32 -left-12 h-72 w-72 rounded-full bg-amber-300/30 blur-3xl" aria-hidden="true"></div>

  <div class="container-x relative text-center text-white">
    <h2 class="text-2xl font-extrabold tracking-tight sm:text-4xl">{title}</h2>
    <p class="mx-auto mt-4 max-w-2xl text-base text-white/90 sm:text-lg">{subtitle}</p>
    <div class="mt-7 flex flex-col items-center justify-center gap-3 sm:flex-row">
      <a href="/#quote" class="btn bg-white text-ink-900 px-6 py-3.5 text-base hover:bg-ink-50">
        {primary}
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
      <a href={whatsappUrl()} target="_blank" rel="noopener" class="btn bg-ink-900 text-white px-6 py-3.5 text-base hover:bg-ink-800">
        <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true">
          <path d="M.057 24l1.687-6.163a11.867 11.867 0 0 1-1.587-5.946C.157 5.335 5.493 0 12.05 0a11.82 11.82 0 0 1 8.413 3.488 11.82 11.82 0 0 1 3.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 0 1-5.688-1.448L.057 24z"/>
        </svg>
        {secondary}
      </a>
    </div>
  </div>
</section>
