---
import JsonLd from './JsonLd.astro';
import type { FAQ } from '~/data/faqs';

export interface Props {
  faqs: FAQ[];
}
const { faqs } = Astro.props;

const data = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.answer,
    },
  })),
};
---

<JsonLd data={data} />
