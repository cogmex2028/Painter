---
// Google Analytics 4 loader. Renders nothing if no measurement ID is configured,
// so local builds and previews stay clean. Set PUBLIC_GA4_ID at deploy time, or
// hard-code in src/data/site.ts under analytics.ga4MeasurementId.
import { site } from '~/data/site';

const envId = import.meta.env.PUBLIC_GA4_ID as string | undefined;
const id = (envId && envId.trim()) || site.analytics.ga4MeasurementId.trim();

// Light validation — GA4 IDs always start with G- and are short
const isValid = /^G-[A-Z0-9]{6,}$/i.test(id);
---

{isValid && (
  <>
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${id}`}></script>
    <script is:inline define:vars={{ id }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){ dataLayer.push(arguments); }
      gtag('js', new Date());
      // anonymize_ip + no ad-personalization features = privacy-friendly default
      gtag('config', id, {
        anonymize_ip: true,
        allow_google_signals: false,
        allow_ad_personalization_signals: false,
      });

      // ─── Conversion tracking ───
      // Fire custom events on every WhatsApp click, phone tap and form submit
      // so we can measure: pageviews → engagements → leads in GA4.
      (function () {
        function trackEvent(name, params) {
          if (typeof window.gtag === 'function') {
            window.gtag('event', name, Object.assign({ source_page: location.pathname }, params || {}));
          }
        }

        // Click delegation on the whole document — catches every anchor
        document.addEventListener('click', function (e) {
          var a = e.target && e.target.closest ? e.target.closest('a') : null;
          if (!a) return;
          var href = a.getAttribute('href') || '';
          // WhatsApp deep links
          if (href.indexOf('wa.me/') !== -1) {
            trackEvent('whatsapp_click', { link_url: href, link_text: (a.textContent || '').trim().slice(0, 60) });
          }
          // Phone clicks
          else if (href.indexOf('tel:') === 0) {
            trackEvent('phone_click', { phone_number: href.replace('tel:', '') });
          }
          // Internal navigation to /pricing — useful for funnel
          else if (href === '/pricing/' || href.indexOf('/pricing/') !== -1) {
            trackEvent('pricing_link_click');
          }
        });

        // Quote form submit
        document.addEventListener('submit', function (e) {
          var form = e.target;
          if (form && form.id === 'quote-form') {
            var serviceSelect = form.querySelector('select[name="service"]');
            var areaSelect = form.querySelector('select[name="area"]');
            var propertySelect = form.querySelector('select[name="property_type"]');
            trackEvent('quote_form_submit', {
              service:  serviceSelect  ? serviceSelect.value  : '',
              area:     areaSelect     ? areaSelect.value     : '',
              property: propertySelect ? propertySelect.value : '',
            });
            // Also fire as a 'generate_lead' event — GA4's built-in conversion
            trackEvent('generate_lead', { method: 'whatsapp_form', value: 1 });
          }
        });

        // Fire pricing_view on the pricing page
        if (location.pathname.indexOf('/pricing') === 0) {
          // Wait a beat so gtag config is ready
          setTimeout(function () { trackEvent('pricing_view'); }, 250);
        }
      })();
    </script>
  </>
)}
