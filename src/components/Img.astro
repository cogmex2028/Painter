---
import { altFor } from '~/data/images';

export interface Props {
  slot: string;
  alt?: string;
  class?: string;
  aspect?: 'video' | 'square' | '4/3' | '3/2' | 'auto';
  loading?: 'lazy' | 'eager';
  priority?: boolean;
  sizes?: string;
  rounded?: boolean;
  width?: number;
  height?: number;
}

const {
  slot,
  alt: altProp,
  class: cls = '',
  aspect = 'video',
  loading: loadingProp,
  priority = false,
  sizes = '(min-width: 1024px) 800px, 100vw',
  rounded = true,
  width = 1600,
  height = 900,
} = Astro.props;

const loading = loadingProp ?? (priority ? 'eager' : 'lazy');
const decoding = priority ? 'sync' : 'async';
const fetchpriority = priority ? 'high' : undefined;

const aspectClass = {
  video: 'aspect-video',
  square: 'aspect-square',
  '4/3': 'aspect-[4/3]',
  '3/2': 'aspect-[3/2]',
  auto: '',
}[aspect];

const base = `/images/${slot}`;
const altText = altProp ?? altFor(slot) ?? 'Mr Painter Dubai';
---

<picture class={`block overflow-hidden ${rounded ? 'rounded-2xl' : ''} ${cls}`}>
  <source
    type="image/webp"
    srcset={`${base}-sm.webp 640w, ${base}-md.webp 1024w, ${base}.webp 1600w`}
    sizes={sizes}
  />
  <img
    src={`${base}.jpg`}
    alt={altText}
    width={width}
    height={height}
    loading={loading}
    decoding={decoding}
    fetchpriority={fetchpriority}
    class={`block h-full w-full object-cover ${aspectClass}`}
  />
</picture>
