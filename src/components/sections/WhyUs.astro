---
const benefits = [
  {
    title: 'Verified & licensed',
    desc: 'Every painter checked for trade licence, insurance and reference jobs. We re-verify every 6 months.',
    icon: '<path d="M12 2l8 4v6c0 5-3.5 9-8 10-4.5-1-8-5-8-10V6l8-4z M9 12l2 2 4-4" stroke-linejoin="round" stroke-linecap="round"/>',
    accent: 'bg-emerald-50 text-emerald-700 ring-emerald-100',
  },
  {
    title: '5 quotes, not 1',
    desc: 'Compare side-by-side. See ratings, photos, response times — no pushy sales calls.',
    icon: '<path d="M4 6h16M4 12h12M4 18h8" stroke-linecap="round"/>',
    accent: 'bg-brand-50 text-brand-700 ring-brand-100',
  },
  {
    title: 'No hidden fees',
    desc: 'Locked quotes in writing. What you see is what you pay. Free re-quotes if scope changes.',
    icon: '<path d="M9 12l2 2 4-4 M12 22a10 10 0 1 1 0-20 10 10 0 0 1 0 20z" stroke-linecap="round" stroke-linejoin="round"/>',
    accent: 'bg-sky-50 text-sky-700 ring-sky-100',
  },
  {
    title: 'Fastest response',
    desc: 'Most quotes arrive in under an hour. Many painters can start the same day.',
    icon: '<path d="M12 7v5l3 3 M12 22a10 10 0 1 1 0-20 10 10 0 0 1 0 20z" stroke-linecap="round" stroke-linejoin="round"/>',
    accent: 'bg-amber-50 text-amber-700 ring-amber-100',
  },
  {
    title: '12-month warranty',
    desc: 'Every job covered. Issues? We back you up. Extended 5-year warranty on exterior coats.',
    icon: '<path d="M12 2l8 4v6c0 5-3.5 9-8 10-4.5-1-8-5-8-10V6l8-4z" stroke-linejoin="round"/>',
    accent: 'bg-violet-50 text-violet-700 ring-violet-100',
  },
  {
    title: 'English & Arabic',
    desc: 'Chat with painters in your language. Bilingual concierge available 7 days a week.',
    icon: '<path d="M3 5h12M9 3v2 M7 5c0 6-4 8-4 8 M5 9c0 2.5 4 5 9 5 M14 21l4-10 4 10 M16 17h4" stroke-linecap="round" stroke-linejoin="round"/>',
    accent: 'bg-rose-50 text-rose-700 ring-rose-100',
  },
];
---

<section class="relative overflow-hidden bg-ink-950 py-20 text-white sm:py-24">
  <div class="absolute inset-0" aria-hidden="true">
    <div class="absolute -left-20 top-20 h-72 w-72 rounded-full bg-brand-500/20 blur-3xl"></div>
    <div class="absolute right-0 bottom-0 h-96 w-96 rounded-full bg-amber-500/10 blur-3xl"></div>
  </div>

  <div class="container-x relative">
    <div class="mx-auto max-w-2xl text-center">
      <span class="inline-flex items-center gap-2 rounded-full bg-white/10 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-brand-300 ring-1 ring-white/15 backdrop-blur">
        Why Mr Painter Dubai
      </span>
      <h2 class="mt-4 text-3xl font-extrabold tracking-tight text-white sm:text-4xl">
        Built to make hiring painters in Dubai actually easy
      </h2>
      <p class="mt-3 text-ink-300">
        We obsess over the small stuff so you don't have to chase, haggle, or hope for the best.
      </p>
    </div>

    <ul class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {benefits.map((b) => (
        <li class="group rounded-2xl bg-white/5 p-6 ring-1 ring-white/10 backdrop-blur transition-colors hover:bg-white/10">
          <span class={`grid h-11 w-11 place-items-center rounded-xl ring-1 ${b.accent}`}>
            <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" set:html={b.icon} />
          </span>
          <h3 class="mt-5 text-lg font-bold text-white">{b.title}</h3>
          <p class="mt-1.5 text-sm text-ink-300">{b.desc}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
