---
import { areas } from '~/data/areas';
import { imageForArea, imageExistsForArea } from '~/data/images';
import Img from '~/components/Img.astro';
---

<section id="areas" class="relative overflow-hidden bg-white py-20 sm:py-24">
  <div class="absolute inset-x-0 top-0 h-72 bg-gradient-to-b from-ink-50 to-transparent" aria-hidden="true"></div>

  <div class="container-x relative">
    <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <div class="max-w-2xl">
        <span class="eyebrow">Areas we cover</span>
        <h2 class="mt-4 text-3xl font-extrabold tracking-tight text-ink-900 sm:text-4xl">
          Painters in your community, ready today
        </h2>
        <p class="mt-3 text-ink-600">
          Every neighbourhood has its own panel of vetted painters. Pick yours below or get matched automatically.
        </p>
      </div>
      <a href="#quote" class="btn-ghost text-sm self-start md:self-auto">Match me with a painter</a>
    </div>

    <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {areas.map((a) => (
        <li>
          <a
            href={`/areas/${a.slug}/`}
            class="card group relative flex h-full flex-col overflow-hidden"
          >
            {imageExistsForArea(a.slug) ? (
              <div class="relative">
                <Img slot={imageForArea(a.slug)} aspect="3/2" rounded={false} sizes="(min-width: 1024px) 400px, (min-width: 640px) 50vw, 100vw" />
                <div class="absolute inset-0 bg-gradient-to-t from-ink-950/60 via-ink-950/10 to-transparent" aria-hidden="true"></div>
                <div class="absolute left-4 bottom-4 right-4">
                  <p class="text-[11px] font-bold uppercase tracking-wider text-white/80">{a.sector}</p>
                  <h3 class="mt-1 text-xl font-bold text-white drop-shadow-sm">Painters in {a.name}</h3>
                </div>
                <span class="absolute right-4 top-4 grid h-10 w-10 place-items-center rounded-xl bg-white/95 text-brand-600 shadow-md ring-1 ring-white/40 backdrop-blur transition-colors group-hover:bg-brand-500 group-hover:text-white">
                  <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 22s8-7.58 8-13a8 8 0 1 0-16 0c0 5.42 8 13 8 13z"/>
                    <circle cx="12" cy="9" r="3"/>
                  </svg>
                </span>
              </div>
            ) : (
              <div class="relative p-6">
                <div class="absolute right-5 top-5 grid h-10 w-10 place-items-center rounded-xl bg-brand-50 text-brand-600 ring-1 ring-brand-100 transition-colors group-hover:bg-brand-500 group-hover:text-white">
                  <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 22s8-7.58 8-13a8 8 0 1 0-16 0c0 5.42 8 13 8 13z"/>
                    <circle cx="12" cy="9" r="3"/>
                  </svg>
                </div>
                <p class="text-xs font-semibold uppercase tracking-wider text-ink-400">{a.sector}</p>
                <h3 class="mt-1 text-xl font-bold text-ink-900">Painters in {a.name}</h3>
              </div>
            )}

            <div class="flex flex-1 flex-col p-6 pt-4">
              <div class="flex flex-wrap gap-1.5">
                {a.highlights.map((h) => (
                  <span class="inline-flex items-center rounded-md bg-ink-100 px-2 py-0.5 text-[11px] font-medium text-ink-700">
                    {h}
                  </span>
                ))}
              </div>

              <div class="mt-auto flex items-end justify-between border-t border-ink-200/70 pt-4">
                <div>
                  <p class="flex items-center gap-1.5 text-sm text-ink-600">
                    <span class="grid h-2 w-2 rounded-full bg-emerald-500"></span>
                    <strong class="text-ink-900">{a.vendorCount} painters</strong> available
                  </p>
                  <p class="mt-1 text-xs text-ink-500">From AED {a.startingFrom.toLocaleString()}</p>
                </div>
                <span class="inline-flex items-center gap-1 text-sm font-semibold text-brand-600 transition-transform group-hover:translate-x-1">
                  View
                  <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M5 12h14M12 5l7 7-7 7"/>
                  </svg>
                </span>
              </div>
            </div>
          </a>
        </li>
      ))}
    </ul>

    <p class="mt-8 text-center text-sm text-ink-500">
      Don't see your area? <a href="#quote" class="font-semibold text-brand-600 hover:underline">Request a painter</a> — we'll find one for you.
    </p>
  </div>
</section>
