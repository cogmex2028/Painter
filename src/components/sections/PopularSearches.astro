---
// Surfaces our money-keyword landing pages on the homepage as an organic-looking
// "Popular searches" block. Doubles as internal-link juice and crawl discovery
// for /painter-in-dubai/, /best-painters-in-dubai/, /painter-near-me/, and the
// per-BHK cost pages — all of which target high-intent queries.
const groups = [
  {
    label: 'Most searched',
    links: [
      { href: '/painter-in-dubai/',          text: 'Painter in Dubai' },
      { href: '/best-painters-in-dubai/',    text: 'Best painters in Dubai' },
      { href: '/painting-company-in-dubai/', text: 'Painting company in Dubai' },
      { href: '/painter-near-me/',           text: 'Painter near me' },
      { href: '/calculator/',                text: 'Painting cost calculator' },
      { href: '/pricing/',                   text: 'Painting prices Dubai' },
    ],
  },
  {
    label: 'By apartment size',
    links: [
      { href: '/painting-cost-1bhk-dubai/', text: '1 BHK painting cost' },
      { href: '/painting-cost-2bhk-dubai/', text: '2 BHK painting cost' },
      { href: '/painting-cost-3bhk-dubai/', text: '3 BHK painting cost' },
      { href: '/services/villa-painting/',  text: 'Villa painting cost' },
      { href: '/services/apartment-painting/', text: 'Apartment painting' },
    ],
  },
  {
    label: 'By job type',
    links: [
      { href: '/services/move-in-painting/',   text: 'Move-in painting' },
      { href: '/services/move-out-painting/',  text: 'Move-out painting' },
      { href: '/services/exterior-painting/',  text: 'Exterior painting' },
      { href: '/services/texture-decorative/', text: 'Marmorino / decorative' },
      { href: '/services/commercial-painting/', text: 'Commercial painting' },
    ],
  },
];
---

<section class="bg-ink-50/60 py-16 sm:py-20">
  <div class="container-x">
    <div class="mx-auto max-w-2xl text-center">
      <span class="eyebrow">Popular searches</span>
      <h2 class="mt-4 text-2xl font-extrabold tracking-tight text-ink-900 sm:text-3xl">
        What other Dubai homeowners are looking for
      </h2>
      <p class="mt-3 text-ink-600">
        The most-clicked painting-related searches in Dubai this month — find your scenario fast.
      </p>
    </div>

    <div class="mt-10 grid gap-8 lg:grid-cols-3">
      {groups.map((g) => (
        <article>
          <h3 class="text-[11px] font-semibold uppercase tracking-[0.2em] text-brand-700">{g.label}</h3>
          <ul class="mt-4 space-y-2">
            {g.links.map((l) => (
              <li>
                <a
                  href={l.href}
                  class="group flex items-center justify-between rounded-xl bg-white px-4 py-3 text-sm font-medium text-ink-800 ring-1 ring-ink-200/70 transition-all hover:bg-brand-50/40 hover:ring-brand-300"
                >
                  <span>{l.text}</span>
                  <svg class="h-3.5 w-3.5 text-ink-400 transition-transform group-hover:translate-x-0.5 group-hover:text-brand-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M5 12h14M12 5l7 7-7 7"/>
                  </svg>
                </a>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>
