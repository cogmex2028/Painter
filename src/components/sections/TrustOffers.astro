---
import { trustOffers } from '~/data/pricing';

const icons: Record<string, string> = {
  shield: '<path d="M12 2l8 4v6c0 5-3.5 9-8 10-4.5-1-8-5-8-10V6l8-4z M9 12l2 2 4-4" stroke-linejoin="round" stroke-linecap="round"/>',
  wallet: '<path d="M4 7h14a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H4V7z M4 7V5a1 1 0 0 1 1-1h11M16 13h2" stroke-linejoin="round" stroke-linecap="round"/>',
  home:   '<path d="M3 11l9-8 9 8M5 10v10h14V10" stroke-linejoin="round" stroke-linecap="round"/>',
  certificate: '<path d="M12 15l-3 6 3-2 3 2-3-6 M12 3a6 6 0 1 1 0 12 6 6 0 0 1 0-12z" stroke-linejoin="round" stroke-linecap="round"/>',
  lightning: '<path d="M13 2L4 14h6l-2 8 9-12h-6l2-8z" stroke-linejoin="round" stroke-linecap="round"/>',
};
---

<section class="border-y border-ink-200/60 bg-gradient-to-r from-brand-50/40 via-amber-50/20 to-brand-50/40">
  <div class="container-x py-10 sm:py-14">
    <p class="text-center text-[11px] font-semibold uppercase tracking-[0.25em] text-brand-700">
      Why customers stay loyal to us
    </p>
    <h2 class="mx-auto mt-3 max-w-3xl text-center text-2xl font-extrabold tracking-tight text-ink-900 sm:text-3xl">
      Five promises behind every quote
    </h2>

    <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
      {trustOffers.map((offer) => (
        <li class="group flex flex-col rounded-2xl bg-white p-5 ring-1 ring-ink-200/70 transition-all hover:ring-brand-300 hover:shadow-md">
          <span class="grid h-10 w-10 place-items-center rounded-xl bg-brand-50 text-brand-600 ring-1 ring-brand-100 transition-colors group-hover:bg-brand-500 group-hover:text-white">
            <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" set:html={icons[offer.icon] ?? icons.shield} />
          </span>
          <h3 class="mt-4 text-sm font-bold text-ink-900">{offer.title}</h3>
          <p class="mt-1.5 text-xs leading-relaxed text-ink-600">{offer.body}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
