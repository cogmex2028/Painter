---
import { whatsappUrl } from '~/data/site';
---

<section class="relative overflow-hidden bg-gradient-to-br from-brand-600 via-brand-500 to-amber-500 py-20 sm:py-24">
  <div class="absolute inset-0 bg-grid opacity-20" aria-hidden="true"></div>
  <div class="absolute -top-24 -right-24 h-72 w-72 rounded-full bg-white/20 blur-3xl" aria-hidden="true"></div>
  <div class="absolute -bottom-32 -left-12 h-72 w-72 rounded-full bg-amber-300/30 blur-3xl" aria-hidden="true"></div>

  <div class="container-x relative">
    <div class="mx-auto max-w-3xl text-center text-white">
      <h2 class="text-3xl font-extrabold tracking-tight sm:text-5xl">
        Ready for a fresh coat?
      </h2>
      <p class="mt-4 text-lg text-white/90">
        Tell us about your project. We'll connect you with the best-rated painters in your area — in under a minute, no commitment.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a href="#quote" class="btn bg-white text-ink-900 px-6 py-3.5 text-base hover:bg-ink-50">
          Get 5 free quotes
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
        <a
          href={whatsappUrl()}
          target="_blank"
          rel="noopener"
          class="btn bg-ink-900 text-white px-6 py-3.5 text-base hover:bg-ink-800"
        >
          <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true">
            <path d="M.057 24l1.687-6.163a11.867 11.867 0 0 1-1.587-5.946C.157 5.335 5.493 0 12.05 0a11.82 11.82 0 0 1 8.413 3.488 11.82 11.82 0 0 1 3.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 0 1-5.688-1.448L.057 24z"/>
          </svg>
          Chat on WhatsApp
        </a>
      </div>
      <p class="mt-6 text-sm text-white/80">
        Trusted by <strong>10,800+ homeowners</strong> · Average response time <strong>under 1 hour</strong>
      </p>
    </div>
  </div>
</section>
