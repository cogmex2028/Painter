---
import { testimonials } from '~/data/testimonials';
---

<section class="bg-ink-50/60 py-20 sm:py-24">
  <div class="container-x">
    <div class="mx-auto max-w-2xl text-center">
      <span class="eyebrow">Real reviews</span>
      <h2 class="mt-4 text-3xl font-extrabold tracking-tight text-ink-900 sm:text-4xl">
        Loved by homeowners across Dubai
      </h2>
      <p class="mt-3 text-ink-600">2,300+ verified five-star reviews and counting.</p>
    </div>

    <ul class="mt-14 grid gap-6 md:grid-cols-3">
      {testimonials.map((t) => (
        <li class="card flex h-full flex-col p-7">
          <svg class="h-7 w-7 text-brand-400" viewBox="0 0 32 32" fill="currentColor" aria-hidden="true">
            <path d="M9.5 8c-3 0-5.5 2.5-5.5 5.5S6.5 19 9.5 19c.5 0 1 0 1.5-.2-.5 2.7-2.5 4.7-5 5.7v2c5-1 8.5-5 8.5-10.5C14.5 11 12.5 8 9.5 8zm12 0c-3 0-5.5 2.5-5.5 5.5S18.5 19 21.5 19c.5 0 1 0 1.5-.2-.5 2.7-2.5 4.7-5 5.7v2c5-1 8.5-5 8.5-10.5C26.5 11 24.5 8 21.5 8z"/>
          </svg>
          <blockquote class="mt-4 flex-1 text-base leading-relaxed text-ink-800">
            "{t.quote}"
          </blockquote>

          <div class="mt-6 flex items-center gap-3 border-t border-ink-200/70 pt-5">
            <span class={`grid h-11 w-11 place-items-center rounded-full bg-gradient-to-br ${t.accent} text-sm font-bold text-white`}>
              {t.initials}
            </span>
            <div class="flex-1">
              <p class="text-sm font-semibold text-ink-900">{t.author}</p>
              <p class="text-xs text-ink-500">{t.property} · {t.area}</p>
            </div>
            <div class="flex text-amber-500" aria-label={`Rated ${t.rating} out of 5`}>
              {Array.from({ length: t.rating }).map(() => (
                <svg class="h-4 w-4 fill-current" viewBox="0 0 20 20" aria-hidden="true">
                  <path d="M10 1.5l2.6 5.3 5.9.85-4.25 4.15 1 5.85L10 14.9l-5.25 2.75 1-5.85L1.5 7.65l5.9-.85L10 1.5z"/>
                </svg>
              ))}
            </div>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
