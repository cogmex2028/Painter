---
const steps = [
  {
    n: '01',
    title: 'Tell us what you need',
    desc: 'Share your area, property and service in 60 seconds. No phone calls, no back-and-forth.',
    icon: '<path d="M4 6h16M4 12h10M4 18h7" stroke-linecap="round"/>',
  },
  {
    n: '02',
    title: 'Get 5 free quotes',
    desc: 'We instantly match you with the best-rated painters in your community — typically within 1 hour.',
    icon: '<path d="M3 5h12l3 4v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5z M3 5l3 4h12" stroke-linejoin="round"/>',
  },
  {
    n: '03',
    title: 'Compare & book',
    desc: 'Check ratings, portfolios and prices. Chat directly on WhatsApp. Choose the painter that fits you.',
    icon: '<path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"/>',
  },
];
---

<section id="how" class="relative bg-white py-20 sm:py-24">
  <div class="container-x">
    <div class="mx-auto max-w-2xl text-center">
      <span class="eyebrow">How it works</span>
      <h2 class="mt-4 text-3xl font-extrabold tracking-tight text-ink-900 sm:text-4xl">
        Three steps to a freshly painted home
      </h2>
      <p class="mt-3 text-ink-600">Skip the haggling and ghosted calls. Real quotes, real painters, in minutes.</p>
    </div>

    <ol class="mt-14 grid gap-6 md:grid-cols-3">
      {steps.map((s, i) => (
        <li class="card relative p-7">
          <div class="flex items-start justify-between">
            <span class="grid h-12 w-12 place-items-center rounded-xl bg-ink-900 text-white">
              <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" set:html={s.icon} />
            </span>
            <span class="text-4xl font-extrabold tracking-tighter text-ink-100">{s.n}</span>
          </div>
          <h3 class="mt-5 text-xl font-bold text-ink-900">{s.title}</h3>
          <p class="mt-2 text-sm text-ink-600">{s.desc}</p>

          {i < steps.length - 1 && (
            <svg class="absolute -right-3 top-1/2 hidden -translate-y-1/2 text-ink-300 md:block" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14M13 6l6 6-6 6"/>
            </svg>
          )}
        </li>
      ))}
    </ol>
  </div>
</section>
