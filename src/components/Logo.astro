---
export interface Props {
  variant?: 'light' | 'dark';
  size?: 'sm' | 'md' | 'lg';
}
const { variant = 'dark', size = 'md' } = Astro.props;
const text = variant === 'light' ? 'text-white' : 'text-ink-900';
const sub = variant === 'light' ? 'text-brand-300' : 'text-brand-600';
const sizeMap = {
  sm: { mark: 'h-8 w-8', icon: 'h-4 w-4', wordmark: 'text-base', sub: 'text-[10px]' },
  md: { mark: 'h-9 w-9', icon: 'h-5 w-5', wordmark: 'text-lg', sub: 'text-[11px]' },
  lg: { mark: 'h-11 w-11', icon: 'h-6 w-6', wordmark: 'text-xl', sub: 'text-xs' },
} as const;
const s = sizeMap[size];
---

<a
  href="/"
  class={`group inline-flex items-center gap-2.5 font-display font-extrabold ${text}`}
  aria-label="Mr Painter Dubai — Home"
>
  <span class={`relative grid ${s.mark} place-items-center overflow-hidden rounded-xl bg-gradient-to-br from-brand-500 to-brand-700 shadow-md shadow-brand-500/30 transition-transform group-hover:scale-105`}>
    <svg viewBox="0 0 24 24" class={`${s.icon} text-white`} fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M7 16V8a2 2 0 0 1 2-2h7a2 2 0 0 1 2 2v2H9v6z" />
      <circle cx="8" cy="18" r="2" />
    </svg>
    <span class="absolute inset-0 bg-white/20 mix-blend-overlay" aria-hidden="true"></span>
  </span>
  <span class="flex flex-col leading-tight">
    <span class={`${s.wordmark} tracking-tight`}>
      Mr Painter<span class="text-brand-500">.</span>
    </span>
    <span class={`${sub} font-semibold uppercase tracking-[0.18em] opacity-80`}>Dubai</span>
  </span>
</a>
