---
export interface Props {
  variant?: 'light' | 'dark';
  size?: 'sm' | 'md' | 'lg';
}
const { variant = 'dark', size = 'md' } = Astro.props;
const text = variant === 'light' ? 'text-white' : 'text-ink-900';
const sizeMap = { sm: 'text-lg', md: 'text-xl', lg: 'text-2xl' } as const;
---

<a href="/" class={`group inline-flex items-center gap-2 font-display font-extrabold ${sizeMap[size]} ${text}`} aria-label="PaintHub Dubai — Home">
  <span class="relative grid h-9 w-9 place-items-center overflow-hidden rounded-xl bg-gradient-to-br from-brand-500 to-brand-700 shadow-md shadow-brand-500/30 transition-transform group-hover:scale-105">
    <svg viewBox="0 0 24 24" class="h-5 w-5 text-white" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M7 16V8a2 2 0 0 1 2-2h7a2 2 0 0 1 2 2v2H9v6z" />
      <circle cx="8" cy="18" r="2" />
    </svg>
    <span class="absolute inset-0 bg-white/20 mix-blend-overlay" aria-hidden="true"></span>
  </span>
  <span class="tracking-tight">
    PaintHub<span class="text-brand-500">.</span>
  </span>
</a>
