---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { areas } from '~/data/areas';
import { services } from '~/data/services';

const title = 'Page not found — PaintHub Dubai';
const description = 'The page you were looking for has moved or doesn\'t exist. Find painters by area or service on PaintHub Dubai.';
---

<BaseLayout title={title} description={description} noindex>
  <section class="relative overflow-hidden bg-gradient-to-b from-brand-50/60 via-white to-white">
    <div class="absolute inset-0 bg-grid mask-fade-b opacity-50" aria-hidden="true"></div>
    <div class="container-x relative py-20 sm:py-28 text-center">
      <p class="text-sm font-semibold uppercase tracking-widest text-brand-600">404</p>
      <h1 class="mt-4 text-4xl font-extrabold tracking-tight text-ink-900 sm:text-6xl">Page not found</h1>
      <p class="mx-auto mt-5 max-w-xl text-base text-ink-600 sm:text-lg">
        The page you were looking for has moved or never existed. While you are here — PaintHub Dubai matches homeowners and businesses with verified painters across 35+ communities. Get a free quote in under a minute, or browse our services and areas below. If you arrived through a saved link, the page may have been renamed when we updated our community coverage — try searching by area instead.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a href="/" class="btn-primary text-base">Back to homepage</a>
        <a href="/areas" class="btn-ghost text-base">Browse all areas</a>
      </div>
    </div>
  </section>

  <section class="bg-white py-16 sm:py-20">
    <div class="container-x">
      <h2 class="text-xl font-bold text-ink-900">Popular areas</h2>
      <ul class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {areas.slice(0, 6).map((a) => (
          <li>
            <a href={`/areas/${a.slug}`} class="card flex items-center justify-between p-5">
              <span class="font-semibold text-ink-900">Painters in {a.name}</span>
              <svg class="h-5 w-5 text-ink-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </a>
          </li>
        ))}
      </ul>

      <h2 class="mt-12 text-xl font-bold text-ink-900">All services</h2>
      <ul class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {services.map((s) => (
          <li>
            <a href={`/services/${s.slug}`} class="card flex items-center justify-between p-5">
              <span class="font-semibold text-ink-900">{s.name}</span>
              <svg class="h-5 w-5 text-ink-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>
