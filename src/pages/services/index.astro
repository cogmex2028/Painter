---
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHero from '~/components/page/PageHero.astro';
import Section from '~/components/page/Section.astro';
import QuoteCTA from '~/components/page/QuoteCTA.astro';

import Breadcrumbs from '~/components/schema/Breadcrumbs.astro';
import JsonLd from '~/components/schema/JsonLd.astro';

import { services } from '~/data/services';
import { site } from '~/data/site';
import { imageForService } from '~/data/images';
import Img from '~/components/Img.astro';

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Services', href: '/services/' },
];

const title = 'Painting Services in Dubai — Interior & Exterior';
const description =
  'All painting services in Dubai — interior, exterior, villa, apartment, commercial and decorative. Free quotes from 120+ verified pros. Same-day starts.';

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${site.url}/services#collection`,
  name: title,
  description,
  url: `${site.url}/services/`,
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: services.length,
    itemListElement: services.map((s, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: `${site.url}/services/${s.slug}/`,
      name: s.name,
    })),
  },
};
---

<BaseLayout title={title} description={description}>
  <PageHero
    eyebrow="All services"
    title="Every painting service you'll need in Dubai"
    subtitle="From a single feature wall to a full villa repaint, our verified pros cover every type of painting job — residential, commercial and decorative."
    breadcrumbs={breadcrumbs}
    stats={[
      { label: 'Services', value: `${services.length}+` },
      { label: 'Verified pros', value: '120+' },
      { label: 'Avg. response', value: 'Under 1 hr' },
      { label: 'Warranty', value: '12 mo+' },
    ]}
  />

  <Section bg="white">
    <div class="grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <span class="eyebrow">How painting works in Dubai</span>
        <h2 class="mt-4 text-2xl font-extrabold tracking-tight text-ink-900 sm:text-3xl">Six disciplines, one marketplace</h2>
        <div class="prose mt-6 space-y-4 text-base leading-relaxed text-ink-700">
          <p>
            Painting in Dubai is not one trade — it is six. The painter who applies Italian Marmorino in a Downtown penthouse is not the same person who weatherproofs a Palm Jumeirah villa exterior, and neither is the right fit for a same-day apartment turnaround in JLT. PaintHub maintains six service categories so that the right specialist is matched to your project, every time.
          </p>
          <p>
            Each service has its own paint brands, prep standards, scheduling conventions and warranty terms. Interior emulsions like Jotun Lady and Dulux Diamond dominate the residential market. Elastomeric and silicone systems like Jotun Jotashield and Caparol AmphiSilan rule the exterior. Commercial work demands fire-rated formulations with MSDS paperwork and night-shift logistics. Decorative work belongs to a small group of imported-material specialists trained in Italy.
          </p>
          <p>
            Whatever your project, the page below walks you through what is included, who the right vendor is, and what fair pricing looks like in 2026 Dubai. Choose your service, or send us a brief and we will route you.
          </p>
        </div>
      </div>
      <aside class="lg:col-span-5">
        <div class="rounded-2xl bg-gradient-to-br from-brand-50 to-amber-50 p-6 ring-1 ring-brand-100">
          <h3 class="text-lg font-bold text-ink-900">How to choose</h3>
          <dl class="mt-5 space-y-4 text-sm">
            <div>
              <dt class="font-semibold text-ink-900">Going for a refresh?</dt>
              <dd class="mt-1 text-ink-600">Interior painting covers walls, ceilings and rooms. The fastest, lowest-impact option.</dd>
            </div>
            <div>
              <dt class="font-semibold text-ink-900">Tackling sun damage?</dt>
              <dd class="mt-1 text-ink-600">Exterior painting with an elastomeric system is the answer. Look for a 5-year warranty.</dd>
            </div>
            <div>
              <dt class="font-semibold text-ink-900">Repainting your whole villa?</dt>
              <dd class="mt-1 text-ink-600">A villa package bundles interior, exterior and boundary walls into one fixed-price quote.</dd>
            </div>
            <div>
              <dt class="font-semibold text-ink-900">Tenant turnover?</dt>
              <dd class="mt-1 text-ink-600">Apartment painting — fast, landlord-spec colour matching, single-day finish.</dd>
            </div>
            <div>
              <dt class="font-semibold text-ink-900">Want a statement wall?</dt>
              <dd class="mt-1 text-ink-600">Texture and decorative — Italian Marmorino, Stucco Veneziano, gold leaf.</dd>
            </div>
          </dl>
        </div>
      </aside>
    </div>
  </Section>

  <Section eyebrow="The full menu" title="Every painting service we offer" bg="ink-50">
    <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {services.map((s) => (
        <li>
          <a href={`/services/${s.slug}/`} class="card group relative flex h-full flex-col overflow-hidden">
            <div class="relative">
              <Img slot={imageForService(s.slug)} aspect="3/2" rounded={false} sizes="(min-width: 1024px) 400px, (min-width: 640px) 50vw, 100vw" />
              <div class="absolute inset-0 bg-gradient-to-t from-ink-950/40 via-transparent to-transparent" aria-hidden="true"></div>
              {s.popular && (
                <span class="absolute right-4 top-4 rounded-full bg-amber-100 px-2.5 py-1 text-[11px] font-bold uppercase tracking-wider text-amber-800 ring-1 ring-amber-200">Popular</span>
              )}
            </div>
            <div class="flex flex-1 flex-col p-6">
              <h2 class="text-lg font-bold text-ink-900">{s.name}</h2>
              <p class="mt-1 text-sm text-ink-500">{s.short}</p>
              <p class="mt-3 text-sm text-ink-600 line-clamp-3">{s.description}</p>
              <div class="mt-auto flex items-center justify-between border-t border-ink-200/70 pt-4">
                <div>
                  <p class="text-[11px] font-semibold uppercase tracking-wider text-ink-400">From</p>
                  <p class="text-base font-bold text-ink-900">AED {s.startingPrice.toLocaleString()}</p>
                </div>
                <span class="inline-flex items-center gap-1 text-sm font-semibold text-brand-600 transition-transform group-hover:translate-x-1">
                  Learn more
                  <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M5 12h14M12 5l7 7-7 7"/>
                  </svg>
                </span>
              </div>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </Section>

  <Section eyebrow="Choosing right" title="Three questions that decide your service" bg="white">
    <div class="grid gap-6 md:grid-cols-3">
      <article class="card p-7">
        <h3 class="text-lg font-bold text-ink-900">1. How big is the space?</h3>
        <p class="mt-3 text-sm leading-relaxed text-ink-600">
          A studio is a single-day apartment-painting job. A 5-bedroom villa with interior, exterior and boundary wall is a 7-10 day full-villa package. Be honest about scale at the brief stage — a vendor who specialises in 1-3BR apartments is not the right team to run a Frond villa, and vice versa.
        </p>
      </article>
      <article class="card p-7">
        <h3 class="text-lg font-bold text-ink-900">2. Indoor, outdoor, or both?</h3>
        <p class="mt-3 text-sm leading-relaxed text-ink-600">
          Interior and exterior are different products and different specialisms. Premium emulsion (Jotun Lady, Dulux Diamond) for walls and ceilings. Elastomeric or silicone (Jotun Jotashield, Caparol AmphiSilan) for outdoor. Mixing them is the most common shortcut, and the most common reason exterior paint fails within 18 months.
        </p>
      </article>
      <article class="card p-7">
        <h3 class="text-lg font-bold text-ink-900">3. Functional or decorative?</h3>
        <p class="mt-3 text-sm leading-relaxed text-ink-600">
          A standard repaint is functional — the goal is a clean, durable finish. Decorative work (Marmorino, Stucco Veneziano, gold leaf) is hand-applied craft using imported Italian materials. The price gap is significant — AED 12-22/sqft vs AED 35-120/sqft. If you want a statement, plan for it. If you want fresh walls, do not pay artisan rates.
        </p>
      </article>
    </div>
  </Section>

  <QuoteCTA title="Not sure which service you need?" subtitle="Tell us a bit about your space and we'll match you with the right specialist." />

  <Breadcrumbs items={breadcrumbs.map((b) => ({ name: b.name, url: b.href }))} slot="head" />
  <JsonLd data={itemListSchema} slot="head" />
</BaseLayout>
