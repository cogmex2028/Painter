---
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHero from '~/components/page/PageHero.astro';
import Section from '~/components/page/Section.astro';
import InlineFAQ from '~/components/page/InlineFAQ.astro';
import VendorCard from '~/components/page/VendorCard.astro';
import QuoteCTA from '~/components/page/QuoteCTA.astro';

import AreaSchema from '~/components/schema/AreaSchema.astro';
import FAQSchema from '~/components/schema/FAQSchema.astro';
import Breadcrumbs from '~/components/schema/Breadcrumbs.astro';

import { areas } from '~/data/areas';
import { vendors } from '~/data/vendors';
import { services } from '~/data/services';
import { imageForArea, imageExistsForArea, imageUrl } from '~/data/images';
import { site } from '~/data/site';
import { areaExtended } from '~/data/area-extended';

export async function getStaticPaths() {
  return areas.map((area) => ({
    params: { slug: area.slug },
    props: { area },
  }));
}

const { area } = Astro.props;

const matchingVendors = vendors.filter((v) => v.areas.includes(area.slug)).slice(0, 5);
const matchingServices = services.filter((s) => area.popularServices?.includes(s.slug));
const nearbyAreas = areas.filter((a) => area.nearbyAreas?.includes(a.slug));
const extended = areaExtended[area.slug];

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Areas', href: '/areas/' },
  { name: area.name, href: `/areas/${area.slug}/` },
];
---

<BaseLayout
  title={area.seoTitle}
  description={area.seoDescription}
  image={imageExistsForArea(area.slug) ? imageUrl(site.url, imageForArea(area.slug)) : undefined}
>
  <PageHero
    eyebrow={area.sector}
    title={`Painters in ${area.name}`}
    subtitle={area.intro}
    breadcrumbs={breadcrumbs}
    imageSlot={imageExistsForArea(area.slug) ? imageForArea(area.slug) : undefined}
    stats={[
      { label: 'Verified pros', value: `${area.vendorCount}+` },
      { label: 'Starting from', value: `AED ${area.startingFrom.toLocaleString()}` },
      { label: 'Avg. response', value: 'Under 1 hr' },
      { label: 'Sector', value: area.sector.split('&')[0].trim() },
    ]}
  />

  <!-- Local context -->
  <Section eyebrow={`About ${area.name}`} title={`What to know about painting in ${area.name}`} bg="white">
    <div class="grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-7 prose-area">
        <p class="text-base leading-relaxed text-ink-700 sm:text-lg">{area.localContext}</p>
        <h3 class="mt-8 text-lg font-bold text-ink-900">Common property types</h3>
        <ul class="mt-4 flex flex-wrap gap-2">
          {area.popularPropertyTypes.map((p) => (
            <li class="rounded-full bg-ink-100 px-3 py-1 text-xs font-medium text-ink-700">{p}</li>
          ))}
        </ul>
      </div>
      <aside class="lg:col-span-5">
        <div class="rounded-2xl bg-gradient-to-br from-brand-50 to-amber-50 p-6 ring-1 ring-brand-100">
          <h3 class="text-lg font-bold text-ink-900">Quick facts</h3>
          <dl class="mt-4 space-y-3 text-sm">
            <div class="flex justify-between gap-3">
              <dt class="text-ink-600">Vendors available</dt>
              <dd class="font-bold text-ink-900">{area.vendorCount}</dd>
            </div>
            <div class="flex justify-between gap-3">
              <dt class="text-ink-600">Starting price</dt>
              <dd class="font-bold text-ink-900">AED {area.startingFrom.toLocaleString()}</dd>
            </div>
            <div class="flex justify-between gap-3">
              <dt class="text-ink-600">Sector</dt>
              <dd class="font-semibold text-ink-900">{area.sector}</dd>
            </div>
            <div class="flex justify-between gap-3">
              <dt class="text-ink-600">Coverage</dt>
              <dd class="font-semibold text-emerald-700">All clusters</dd>
            </div>
          </dl>
          <a href="/#quote" class="btn-primary mt-6 w-full text-sm">Get a free quote</a>
        </div>
      </aside>
    </div>
  </Section>

  <!-- Vendors in this area -->
  {matchingVendors.length > 0 && (
    <Section eyebrow="Local painters" title={`Top-rated painters in ${area.name}`} subtitle={`Hand-picked vendors actively servicing ${area.name} with verified ratings and insurance.`} bg="ink-50">
      <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
        {matchingVendors.map((v) => <li><VendorCard vendor={v} compact /></li>)}
      </ul>
    </Section>
  )}

  <!-- Price guide -->
  <Section eyebrow="Pricing" title={`How much does painting cost in ${area.name}?`} subtitle="Typical price ranges from our verified local vendors. Final quotes are locked in writing after a free site survey." bg="white">
    <div class="overflow-hidden rounded-2xl ring-1 ring-ink-200/70 bg-white">
      <table class="w-full text-sm">
        <thead class="bg-ink-50">
          <tr class="text-left">
            <th class="px-5 py-4 font-semibold text-ink-700">Property type</th>
            <th class="px-5 py-4 font-semibold text-ink-700 text-right">Typical range (AED)</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-ink-200/60">
          {area.priceGuide.map((row) => (
            <tr class="hover:bg-ink-50/50 transition-colors">
              <td class="px-5 py-4 font-medium text-ink-900">{row.property}</td>
              <td class="px-5 py-4 text-right font-bold text-ink-900 whitespace-nowrap">
                {row.from.toLocaleString()} – {row.to.toLocaleString()}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </Section>

  <!-- What to expect -->
  {extended && (
    <Section eyebrow="On the day" title={`What to expect when painting in ${area.name}`} bg="ink-50">
      <div class="grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <p class="text-base leading-relaxed text-ink-700 sm:text-lg">{extended.whatToExpect}</p>
        </div>
        <div class="lg:col-span-5">
          <div class="rounded-2xl bg-white p-6 ring-1 ring-ink-200/70">
            <h3 class="text-lg font-bold text-ink-900">Owner preparation checklist</h3>
            <ul class="mt-4 space-y-2.5">
              {extended.preparation.map((p) => (
                <li class="flex items-start gap-2.5">
                  <span class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-full bg-emerald-100 text-emerald-700">
                    <svg viewBox="0 0 24 24" class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M5 12l5 5L20 7"/>
                    </svg>
                  </span>
                  <span class="text-sm text-ink-700">{p}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </Section>
  )}

  <!-- Best season + community access -->
  {extended && (
    <Section bg="white">
      <div class="grid gap-10 lg:grid-cols-2">
        <article>
          <span class="eyebrow">Timing</span>
          <h2 class="mt-4 text-2xl font-extrabold tracking-tight text-ink-900 sm:text-3xl">Best season for painting in {area.name}</h2>
          <p class="mt-5 text-base leading-relaxed text-ink-700">{extended.bestSeason}</p>
        </article>
        <article>
          <span class="eyebrow">Access & paperwork</span>
          <h2 class="mt-4 text-2xl font-extrabold tracking-tight text-ink-900 sm:text-3xl">Community access & NOCs</h2>
          <p class="mt-5 text-base leading-relaxed text-ink-700">{extended.communityAccess}</p>
        </article>
      </div>
    </Section>
  )}

  <!-- Cost factors -->
  {extended && (
    <Section eyebrow="What drives the price" title={`Cost factors specific to ${area.name}`} bg="ink-50">
      <ul class="grid gap-3 sm:grid-cols-2">
        {extended.costFactors.map((c) => (
          <li class="card flex items-start gap-3 p-5">
            <span class="mt-0.5 grid h-7 w-7 shrink-0 place-items-center rounded-full bg-brand-50 text-brand-700 ring-1 ring-brand-100">
              <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 8v8M8 12h8"/>
              </svg>
            </span>
            <span class="text-sm text-ink-700">{c}</span>
          </li>
        ))}
      </ul>
    </Section>
  )}

  <!-- Popular services -->
  {matchingServices.length > 0 && (
    <Section eyebrow="Most requested" title={`Popular painting services in ${area.name}`} bg="white">
      <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {matchingServices.map((s) => (
          <li>
            <a href={`/services/${s.slug}/`} class="card group flex h-full flex-col p-6">
              <h3 class="text-lg font-bold text-ink-900">{s.name} in {area.name}</h3>
              <p class="mt-2 text-sm text-ink-600">{s.short}</p>
              <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-brand-600 transition-transform group-hover:translate-x-1">
                Open {s.name.toLowerCase()} guide
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </span>
            </a>
          </li>
        ))}
      </ul>
      <p class="mt-8 text-center text-sm text-ink-500">
        Want a budget benchmark first? See the <a href="/pricing/" class="font-semibold text-brand-700 hover:text-brand-600 underline">full painting price guide for Dubai</a>
        {' '}or estimate your job with the <a href="/calculator/" class="font-semibold text-brand-700 hover:text-brand-600 underline">painting cost calculator</a>.
      </p>
    </Section>
  )}

  <!-- FAQs -->
  <Section eyebrow="FAQ" title={`Painting in ${area.name} — questions answered`} bg="white">
    <InlineFAQ faqs={area.faqs} />
  </Section>

  <!-- Nearby areas -->
  {nearbyAreas.length > 0 && (
    <Section eyebrow="Nearby" title={`Painters near ${area.name}`} bg="ink-50">
      <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {nearbyAreas.map((a) => (
          <li>
            <a href={`/areas/${a.slug}/`} class="card group flex items-center justify-between p-5">
              <div>
                <p class="font-semibold text-ink-900">Painters in {a.name}</p>
                <p class="mt-0.5 text-xs text-ink-500">{a.vendorCount} pros · From AED {a.startingFrom.toLocaleString()}</p>
              </div>
              <svg class="h-5 w-5 text-ink-400 transition-transform group-hover:translate-x-1 group-hover:text-brand-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </a>
          </li>
        ))}
      </ul>
    </Section>
  )}

  <QuoteCTA
    title={`Find your painter in ${area.name}`}
    subtitle="Get up to 5 free quotes from verified local pros — in under a minute."
  />

  <AreaSchema area={area} slot="head" />
  <FAQSchema faqs={area.faqs} slot="head" />
  <Breadcrumbs items={breadcrumbs.map((b) => ({ name: b.name, url: b.href }))} slot="head" />
</BaseLayout>
