---
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHero from '~/components/page/PageHero.astro';
import Section from '~/components/page/Section.astro';
import InlineFAQ from '~/components/page/InlineFAQ.astro';
import QuoteCTA from '~/components/page/QuoteCTA.astro';
import TrustOffers from '~/components/sections/TrustOffers.astro';

import Breadcrumbs from '~/components/schema/Breadcrumbs.astro';
import FAQSchema from '~/components/schema/FAQSchema.astro';
import LocalBusiness from '~/components/schema/LocalBusiness.astro';

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Painting Company in Dubai', href: '/painting-company-in-dubai/' },
];

const title = 'Painting Company in Dubai — Licensed & Insured';
const description =
  'Mr Painter Dubai is a verified painting company in Dubai serving residential, commercial and decorative projects. AED 2M insurance, MSDS docs, after-hours work. WhatsApp +971 54 485 6912.';

const faqs = [
  {
    question: 'What makes a good painting company in Dubai?',
    answer:
      'A reputable painting company in Dubai holds an active trade licence from Dubai Economic Department, AED 1M+ third-party liability insurance, employs experienced painters (not subcontractors with no accountability), provides fixed-price quotes in writing, and offers a workmanship warranty. Mr Painter Dubai validates all of this for every painter on our network.',
  },
  {
    question: 'Do you handle commercial painting contracts?',
    answer:
      'Yes. Our commercial network handles offices, retail, F&B, clinics, schools and warehouses across Dubai with full RAMS documentation, MSDS sheets for HSE review, AED 2M+ liability insurance and after-hours scheduling (evenings, weekends) at no premium.',
  },
  {
    question: 'Can a painting company invoice my Dubai LLC?',
    answer:
      'Yes. Every painter on our network can issue a UAE VAT-compliant invoice to your trade licence, including TRN, project description and payment terms. For large commercial projects we can also issue a single consolidated invoice from Mr Painter Dubai if you prefer.',
  },
  {
    question: 'Do you sign NDAs for sensitive locations?',
    answer:
      'Yes. We routinely sign NDAs for private residences, family offices, executive homes and any project where discretion matters. Photos are not shared without written consent and crews can use side-entrance access where required.',
  },
  {
    question: 'How does a painting company in Dubai handle building NOCs?',
    answer:
      'Every Dubai community (Emaar, Nakheel, DMCC, Dubai Properties) requires a contractor NOC before painting work begins. Our painters hold active NOCs across all major communities and handle the paperwork on your behalf — typically within 24-48 hours for residential, 5-7 days for commercial.',
  },
  {
    question: 'What size projects do you accept?',
    answer:
      'Anything from a single wall touch-up (AED 299) to a full luxury villa repaint (AED 38,000+) to a multi-floor commercial office. No minimum spend. Larger projects (above AED 25,000) include a dedicated project manager and weekly progress reports.',
  },
];
---

<BaseLayout title={title} description={description}>
  <PageHero
    eyebrow="Painting company in Dubai"
    title="Mr Painter Dubai — the painting company built for trust"
    subtitle="A licensed, insured painting company serving Dubai's residential, commercial and decorative projects. Fixed quotes in writing. Trade licence and insurance documents available on request. AED 2M+ liability cover on every job."
    breadcrumbs={breadcrumbs}
    stats={[
      { label: 'Trade licence', value: 'Active' },
      { label: 'Insurance', value: 'AED 2M+' },
      { label: 'Projects done', value: '10.8k+' },
      { label: 'NPS', value: '4.8 ★' },
    ]}
  />

  <TrustOffers />

  <Section eyebrow="The company" title="What separates a good painting company from a great one" bg="white">
    <div class="space-y-4 max-w-3xl text-base leading-relaxed text-ink-700 sm:text-lg">
      <p>
        Dubai has thousands of painters. It does not have thousands of painting companies. The difference matters: a painter is a tradesperson; a painting company carries the paperwork, insurance, professional indemnity and operational accountability that turns a paint job into a contract you can rely on.
      </p>
      <p>
        Mr Painter Dubai is structured as a curated network rather than a single-owner company because it gives our clients the best of both worlds — the accountability of a registered company (centralised quality control, dispute resolution, single point of contact) combined with the flexibility of a specialist network (decorative artisans for decorative work, exterior specialists for villas, fast-turnover crews for apartments).
      </p>
      <p>
        Every painter we add to the network goes through document verification (trade licence, Emirates ID for owners, insurance certificate), a reference call with a previous client, and a spot visit on a live job to verify prep quality. The first job they take through us is shadow-supervised. Painters who drop below 4.0 in customer ratings are removed automatically.
      </p>
      <p>
        For commercial clients, we provide the full documentation pack — RAMS, MSDS, insurance certificates, contractor passes — before work starts. For residential clients, we handle the community NOC paperwork transparently. The customer never has to chase paper.
      </p>
    </div>
  </Section>

  <Section eyebrow="Sectors" title="The painting company services we offer" bg="ink-50">
    <ul class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {[
        { title: 'Residential', desc: 'Apartments, villas, townhouses across 35+ Dubai communities.' },
        { title: 'Commercial', desc: 'Offices, retail, F&B, after-hours scheduling, MSDS docs.' },
        { title: 'Pre-handover', desc: 'New-build snag-fix painting before tenant move-in.' },
        { title: 'Decorative', desc: 'Italian Marmorino, Stucco Veneziano, gold leaf, hand-painted murals.' },
        { title: 'Exterior & weatherproofing', desc: 'Elastomeric coatings, salt-air specialists for Palm, 5-year warranties.' },
        { title: 'Property management', desc: 'Multi-unit landlord contracts, tenant turnover, recurring maintenance.' },
      ].map((s) => (
        <li class="card p-6">
          <h3 class="text-base font-bold text-ink-900">{s.title}</h3>
          <p class="mt-2 text-sm text-ink-600">{s.desc}</p>
        </li>
      ))}
    </ul>
  </Section>

  <Section eyebrow="Documents" title="Paperwork available on request" bg="white">
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
      {[
        { title: 'Trade licence', desc: 'Issued by the Dubai Economic Department, renewed annually.' },
        { title: 'Insurance certificate', desc: 'AED 1M-2M third-party liability, project-specific cover available.' },
        { title: 'MSDS sheets', desc: 'For every paint product used on commercial sites.' },
        { title: 'RAMS document', desc: 'Risk Assessment & Method Statement for HSE approval.' },
      ].map((d) => (
        <article class="card p-6">
          <span class="grid h-10 w-10 place-items-center rounded-xl bg-brand-50 text-brand-700">
            <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z M14 2v6h6 M9 14h6 M9 17h4"/>
            </svg>
          </span>
          <h3 class="mt-4 text-base font-bold text-ink-900">{d.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-ink-600">{d.desc}</p>
        </article>
      ))}
    </div>
  </Section>

  <Section eyebrow="FAQ" title="Painting company in Dubai — questions answered" bg="ink-50">
    <InlineFAQ faqs={faqs} />
  </Section>

  <QuoteCTA
    title="Need a quote from a licensed painting company?"
    subtitle="WhatsApp +971 54 485 6912 — written quote within an hour, paperwork pack supplied on request."
  />

  <Breadcrumbs items={breadcrumbs.map((b) => ({ name: b.name, url: b.href }))} slot="head" />
  <FAQSchema faqs={faqs} slot="head" />
  <LocalBusiness slot="head" />
</BaseLayout>
