# Copy to .env for local builds.
# Production (mrpainterdubai.com) is deployed via Vercel — add the same vars there:
# Vercel → Project → Settings → Environment Variables.

# Google Search Console — HTML tag verification (content="..." value only)
PUBLIC_GSC_VERIFICATION=

# Bing Webmaster Tools — meta tag verification code
PUBLIC_BING_VERIFICATION=

# Production site URL (defaults to https://mrpainterdubai.com in astro.config.mjs)
# SITE_URL=https://mrpainterdubai.com

# GitHub Actions (if using .github/workflows/deploy.yml for GitHub Pages):
# Add PUBLIC_GSC_VERIFICATION and PUBLIC_BING_VERIFICATION as repo secrets at
# github.com/cogmex2028/Painter → Settings → Secrets and variables → Actions
