{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "astro",
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    { "source": "/painter-in-dubai", "destination": "/", "permanent": true },
    { "source": "/painter-in-dubai/", "destination": "/", "permanent": true },
    { "source": "/painting-company-in-dubai", "destination": "/about/", "permanent": true },
    { "source": "/painting-company-in-dubai/", "destination": "/about/", "permanent": true },
    { "source": "/best-painters-in-dubai", "destination": "/", "permanent": true },
    { "source": "/best-painters-in-dubai/", "destination": "/", "permanent": true },
    { "source": "/painting-cost-1bhk-dubai", "destination": "/pricing/", "permanent": true },
    { "source": "/painting-cost-1bhk-dubai/", "destination": "/pricing/", "permanent": true },
    { "source": "/painting-cost-2bhk-dubai", "destination": "/pricing/", "permanent": true },
    { "source": "/painting-cost-2bhk-dubai/", "destination": "/pricing/", "permanent": true },
    { "source": "/painting-cost-3bhk-dubai", "destination": "/pricing/", "permanent": true },
    { "source": "/painting-cost-3bhk-dubai/", "destination": "/pricing/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(jpg|jpeg|png|webp|svg|ico)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
